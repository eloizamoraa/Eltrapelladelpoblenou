# Copia este archivo como .env y rellena la clave de Anthropic.
# DRIVE_ROOT_FOLDER_ID y SHEET_ID los rellena solo `trapella-facturas setup`.

# Clave de la API de Claude (https://console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=

# Buzón donde llegan las facturas
BUZON_FACTURAS=facturas@eltrapelladelpoblenou.com

# Datos de la empresa: ayudan a no confundir al cliente con el proveedor
EMPRESA_NOMBRE=El Trapella del Poblenou
EMPRESA_CIF=

# Carpeta raíz de Drive y hoja de control
DRIVE_ROOT_FOLDER_ID=
SHEET_ID=

# Opcionales
# CLAUDE_MODEL=claude-opus-5-5
# INTERVALO_SEGUNDOS=600
# GMAIL_QUERY=            (sustituye el filtro por destinatario; sintaxis de búsqueda de Gmail)
